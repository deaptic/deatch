{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "dev": "tauri dev",
    "build": "tauri build",
    "vite": "vite",
    "vite:build": "vite build",
    "bindings": "cargo run --manifest-path src-tauri/Cargo.toml --no-default-features -- --export-bindings",
    "lint:ui": "oxlint src",
    "test": "deno test src/"
  },
  "fmt": {
    "include": ["src/"],
    "exclude": ["src/lib/bindings.ts"]
  },
  "lint": {
    "include": ["src/"],
    "exclude": ["src/lib/bindings.ts"],
    "rules": {
      "exclude": [
        "no-window",
        "no-window-prefix",
        "require-await",
        "no-empty",
        "jsx-button-has-type"
      ]
    }
  }
}
