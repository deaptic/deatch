{
  "manifest_version": 3,
  "name": "Deatch Link",
  "version": "0.3.0",
  "description": "Sends the Twitch channel you're watching to the Deatch desktop app so its Watch tab follows along.",
  "homepage_url": "https://github.com/Deaptic/deatch",
  "key": "",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "deatch-link@deaptic.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["tabs", "nativeMessaging"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
