{
  "manifest_version": 3,
  "name": "Deatch Link",
  "version": "0.2.1",
  "description": "Sends the Twitch channel you're watching to the Deatch desktop app so its Watch tab follows along.",
  "homepage_url": "https://github.com/Deaptic/deatch",
  "browser_specific_settings": {
    "gecko": {
      "id": "deatch-link@deaptic.com",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/deaptic/deatch/main/extension/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["tabs", "nativeMessaging"],
  "background": {
    "scripts": ["channel.js", "background.js"]
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
