{
  "manifest_version": 3,
  "name": "Deatch Link",
  "version": "0.5.0",
  "description": "Links your Twitch tabs to the Deatch desktop app, with a volume compressor, bonus channel points and drops claiming.",
  "homepage_url": "https://github.com/Deaptic/deatch",
  "key": "",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "deatch-link@deaptic.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": [
    "https://twitch.tv/*",
    "https://www.twitch.tv/*",
    "https://m.twitch.tv/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Deatch Link"
  }
}
